DIMENSIONS ntax=10 nsplits=17;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 9,
	100	 2 9,
	100	 6,
	100	 2 6 9,
	100	 7,
	100	 2 6 7 9,
	100	 3,
	100	 8,
	100	 3 8,
	100	 1 4 5 10,
	100	 4,
	100	 10,
	100	 4 10,
	100	 1 5,
	100	 5,
	100	 1,
;
