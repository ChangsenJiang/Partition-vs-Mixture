#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'ANAPLA'
[2] 'CALSQU'
[3] 'JUNHYE'
[4] 'NOTORN'
[5] 'URILOM'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=7;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	100	 5,
	100	 3 5,
	100	 4,
	100	 1 2,
	100	 1,
;
END; [Splits]

