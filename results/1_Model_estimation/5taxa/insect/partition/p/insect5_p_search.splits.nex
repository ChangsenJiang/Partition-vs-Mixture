#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'Lepeophtheirus_salmonis'
[2] 'Stylops_melittae'
[3] 'Anurida_maritima'
[4] 'DROSOPHILA_MELANOGASTER'
[5] 'Essigella_californica'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=7;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 4,
	100	 2 4,
	100	 5,
	100	 1 3,
	100	 3,
	100	 1,
;
END; [Splits]

