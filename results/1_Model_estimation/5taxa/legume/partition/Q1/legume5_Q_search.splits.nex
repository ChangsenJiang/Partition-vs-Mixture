#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'Fragaria_vesca'
[2] 'Lathyrus_sativus'
[3] 'Linum_usitatissimum'
[4] 'Lactuca_sativa'
[5] 'Mimulus_guttatus'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=8;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	100	 4,
	100	 5,
	100	 4 5,
	100	 1 2,
	100	 1,
	0	 2 3,
;
END; [Splits]

