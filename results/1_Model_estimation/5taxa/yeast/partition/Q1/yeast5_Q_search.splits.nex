#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'Candida_apicola'
[2] 'Nakaseomyces_castellii'
[3] 'Schizosaccharomyces_pombe'
[4] 'yHMPu5000034614_Saturnispora_silvae'
[5] 'Metschnikowia_bowlesiae'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=7;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 4,
	100	 5,
	100	 4 5,
	100	 1 3,
	100	 3,
	100	 1,
;
END; [Splits]

